# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=

# Snowflake (read-only role for the agent)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=NBA_READONLY
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=NBA
SNOWFLAKE_SCHEMA=MARTS

# Local fallback warehouse
DUCKDB_PATH=data/nba.duckdb
